# NASA Open API Configuration
# Get your free NASA API Key at: https://api.nasa.gov/
NASA_API_KEY=your_nasa_api_key_here

# NASA Earthdata Login Credentials (Optional, for downloading raw HDF/NetCDF granules from LP DAAC)
# Register free at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here
EARTHDATA_BEARER_TOKEN=your_token_here

# NASA FIRMS Active Fire API Key (Optional)
# Request at: https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=your_firms_key_here
